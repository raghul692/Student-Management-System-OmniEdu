# ==========================================
# OmniEdu Server — Environment Configuration
# ==========================================

# Server Network
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://resumate:resumate_secret@127.0.0.1:5432/omniedu_db?schema=public"

# Authentication & Cryptographic Keys
JWT_ACCESS_SECRET=omniedu_dev_access_secret_super_key_2026
JWT_REFRESH_SECRET=omniedu_dev_refresh_secret_super_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
HALL_TICKET_SECRET=omniedu_dev_hall_ticket_signing_secret_2026

# Redis & Async Background Queues (Optional in dev, required in high-scale prod)
REDIS_URL="redis://127.0.0.1:6379"

# Object Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_BUCKET=omniedu-storage
STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key

# Email Infrastructure (logger | smtp)
EMAIL_PROVIDER=logger
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@omniedu.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="OmniEdu Notifications <no-reply@omniedu.com>"

# Rate Limiting & Telemetry
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=info
