# ==============================================================================
# OMNIEDU — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Multi-Tenant ERP & Intelligent Education Platform
# ==============================================================================

# Core Application Environment
NODE_ENV=production
PORT=5000

# Database Connection (PostgreSQL 16+)
# Recommended production pooling parameters: connection_limit=20&pool_timeout=15
DATABASE_URL=postgresql://omniedu_user:strong_production_password@postgres:5432/omniedu_db?schema=public&connection_limit=20&pool_timeout=15

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Wildcards (*) are STRICTLY FORBIDDEN in production.
CORS_ORIGIN=https://app.omniedu.com,https://api.omniedu.com

# Authentication & Cryptographic Secrets
# CRITICAL: Must be unique, cryptographically random strings (min 32 chars) in production.
JWT_ACCESS_SECRET=your_production_high_entropy_access_secret_min_32_chars_2026
JWT_REFRESH_SECRET=your_production_high_entropy_refresh_secret_min_32_chars_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
HALL_TICKET_SECRET=your_production_hall_ticket_crypto_secret_2026
STORAGE_SIGNING_SECRET=your_production_storage_url_signing_secret_2026

# Redis & Distributed Queue (Cluster / Standalone)
REDIS_URL=redis://:redis_auth_token@redis:6379/0

# Object Storage Configuration (Local or AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_BUCKET=omniedu-storage
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Transactional Email (Logger or SMTP / AWS SES / SendGrid)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_provider_api_key
EMAIL_FROM=OmniEdu Notifications <no-reply@omniedu.com>

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=info

# Database Connection Pool Tuning
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=15000

# Observability, Prometheus Metrics & Distributed Tracing
ENABLE_METRICS=true
ENABLE_TRACING=true

# AI Platform Configuration (Gemini 2.5/3.7 or OpenAI-compatible)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_google_ai_studio_api_key
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MAX_TOKENS_PER_ORG=500000
